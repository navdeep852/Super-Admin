{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VISTAAR Super Admin",
  "version": "3.1.0",
  "identifier": "com.vistaarone.superadmin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VISTAAR Super Admin",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3002 http://127.0.0.1:3002 https://*.supabase.co wss://*.supabase.co 'unsafe-inline' 'unsafe-eval' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "notification": {},
    "fs": {},
    "dialog": {}
  }
}


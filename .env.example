# ==============================================================================
# VISTAAR Super Admin - Environment Configuration Template
# Target: Staging / Production Compatible Platform Control Plane
# ==============================================================================

# Frontend Vite Environment Variables (Exposed in browser bundle)
# NOTE: NEVER include service_role key in VITE_* variables
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...<staging-anon-key>
VITE_GATEWAY_URL=http://localhost:3002

# Gateway BFF Environment Variables (Server-side ONLY; Strictly isolated from browser)
PORT=3002
NODE_ENV=staging
GATEWAY_SUPABASE_URL=https://<staging-project-ref>.supabase.co
GATEWAY_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<staging-service-role-key>
GATEWAY_ASSERTION_SECRET=<64-character-hex-hmac-secret>
PLATFORM_BOOTSTRAP_SECRET=<64-character-hex-bootstrap-secret>
# Optional Payment Webhook Integration (Disabled by default; Gateway starts cleanly without this)
# Set to 'true' only if Youpi payment webhook ingestion is actively used
ENABLE_YOUPI_WEBHOOK=false
# YOUPI_WEBHOOK_SECRET=<optional-youpi-payment-webhook-secret>

# Permitted CORS Origins (Comma-separated)
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002

# PostgreSQL Direct Connection (For Staging Migration Runner & Integration Tests ONLY)
# NEVER point to production database: kluxsykimnjivkqxelba
DATABASE_URL=postgresql://postgres.<staging-ref>:<staging-db-password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres.<staging-ref>:<staging-db-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
